# このファイルをコピーして .env を作り、実際の値を入れる（.env は git に入らない）
#   cp .env.example .env

# Anthropic の API キー（https://console.anthropic.com/ で発行）
ANTHROPIC_API_KEY=

# 文字起こしのモデル。開発中は small、本番・デモ素材は large-v3
WHISPER_MODEL=small

# Claude のモデル。読み取り（重い処理）と軽い処理
CLAUDE_MODEL_HEAVY=claude-opus-5-5
CLAUDE_MODEL_LIGHT=claude-sonnet-5-5

# アプリのログイン用の共通パスワード（空なら、ログインなしで動く。現場で使うときは必ず設定）
APP_PASSWORD=
