#!/bin/sh
# コミット前の検査：秘密情報が混ざっていたらコミットを止める
# 1) .env 系のファイルそのもの（.env.example は許可）
# 2) API キーらしき文字列（英数字20文字以上の本物の形。説明文の見本には反応しない）
# ※ この検査スクリプト自身（.githooks/）は対象外

staged=$(git diff --cached --name-only)
for f in $staged; do
  case "$f" in
    .env|.env.*|*/.env|*/.env.*)
      if [ "$f" != ".env.example" ]; then
        echo "✗ コミット中止：秘密情報ファイル '$f' が含まれています（.gitignore を確認）"
        exit 1
      fi;;
  esac
done

pattern='sk-ant-[A-Za-z0-9_-]{20,}|ANTHROPIC_API_KEY=[A-Za-z0-9_-]{20,}'
if git diff --cached -U0 -- . ':(exclude).githooks' | grep -E '^\+' | grep -E -q "$pattern"; then
  echo "✗ コミット中止：API キーらしき文字列が含まれています"
  git diff --cached -U0 -- . ':(exclude).githooks' | grep -E -n "$pattern" | head -5
  exit 1
fi
exit 0
